# Local development uses a LOCAL Postgres database. `migrate dev` / `db push`
# are guarded against non-local hosts (see prisma.config.ts). In production these
# are set in Vercel and migrations apply via `prisma migrate deploy` on deploy.
DATABASE_URL="postgresql://USER@localhost:5432/workflow_blueprint_dev"
DIRECT_URL="postgresql://USER@localhost:5432/workflow_blueprint_dev"
AUTH_SECRET="replace-this-with-a-long-random-secret-at-least-32-chars"
NEXT_PUBLIC_SITE_URL="https://www.workflowblueprint.io"
RESEND_API_KEY="re_..."
EMAIL_FROM="Workflow Blueprint <hello@workflowblueprint.io>"
ADMIN_EMAILS="admin@example.com"
# Optional knobs for `npm run admin:bootstrap`/`admin:promote`
# (scripts/admin-promote.ts). ADMIN_PROMOTE_ACTOR is recorded as the `actor` on
# the resulting `user.promote_admin` admin audit log entry; without it the script
# falls back to $USER, then $LOGNAME, then the literal "scripts/admin-promote".
# Set ADMIN_PROMOTE_NONINTERACTIVE to exactly "true" to skip the confirmation
# prompt for scripted or CI runs.
ADMIN_PROMOTE_ACTOR="you@example.com"
ADMIN_PROMOTE_NONINTERACTIVE="false"
EXTERNAL_API_KEY="replace-this-with-the-shared-external-api-key"
EXTERNAL_USER_ID="user_demo_alex_blue"
DEMO_USER_PASSWORD="set-only-when-you-need-to-seed-the-demo-account"
# Required in Vercel production to secure the nightly recurring-tasks rollover
# cron; safe to omit locally unless you're manually testing /api/cron/recurring-tasks.
CRON_SECRET="set-only-when-testing-the-cron-route-locally"
# Supabase Storage, for task attachments (src/lib/storage.ts). Per PROJECT.md Q4's
# storage exception — Storage only, never the database. Safe to omit locally unless
# you're testing the attachments feature; storage.ts throws a clear error without them.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-this-with-the-service-role-key-from-supabase-settings"
SUPABASE_STORAGE_BUCKET="task-attachments"
