# Local development uses a LOCAL Postgres database. `migrate dev` / `db push`
# are guarded against non-local hosts (see prisma.config.ts). In production these
# are set in Vercel and migrations apply via `prisma migrate deploy` on deploy.
DATABASE_URL="postgresql://USER@localhost:5432/workflow_blueprint_dev"
DIRECT_URL="postgresql://USER@localhost:5432/workflow_blueprint_dev"
AUTH_SECRET="replace-this-with-a-long-random-secret-at-least-32-chars"
NEXT_PUBLIC_SITE_URL="https://www.workflowblueprint.io"
RESEND_API_KEY="re_..."
EMAIL_FROM="Workflow Blueprint <hello@workflowblueprint.io>"
ADMIN_EMAILS="admin@example.com"
EXTERNAL_API_KEY="replace-this-with-the-shared-external-api-key"
EXTERNAL_USER_ID="user_demo_alex_blue"
DEMO_USER_PASSWORD="set-only-when-you-need-to-seed-the-demo-account"
