    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "resend": "^6.25.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.5.4"
  },
  "overrides": {
