    "@next/env": "^16.4.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.16",
    "lucide-react": "^1.70.0",
    "mcp-handler": "^2.3.1",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "resend": "^6.37.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@4 || 5": "^5.0.12",
    "deepmerge-ts": "^8.0.1",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.8",
    "find-my-way": "^9.8.0",
    "js-yaml": "^4.3.1",
