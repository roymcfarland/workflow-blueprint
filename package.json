{
  "name": "workflow-blueprint",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "engines": {
    "node": "24.22.x"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "vercel-build": "prisma migrate deploy && next build --webpack",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:setup": "npm run db:deploy && npm run db:seed",
    "admin:bootstrap": "tsx scripts/admin-promote.ts",
    "admin:promote": "tsx scripts/admin-promote.ts",
    "postinstall": "prisma generate",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --dir tests/smoke",
    "test:coverage": "vitest run --coverage --exclude \"tests/smoke/**\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
