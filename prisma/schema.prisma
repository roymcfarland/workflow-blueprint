generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThemePreference {
  DAY
  NIGHT
  SYSTEM
}

enum TaskStatus {
  ICE_BOX
  ON_DECK
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum ItemPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrencePattern {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  SEMI_ANNUALLY
  ANNUALLY
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                  String              @id
  name                String
  email               String              @unique
  passwordHash        String
  avatarLabel         String?
  themePreference     ThemePreference     @default(DAY)
  role                UserRole            @default(USER)
  passwordChangedAt   DateTime            @default(now())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  boards              Board[]
  resetTokens         PasswordResetToken[]
  sentInvitations     Invitation[]        @relation("InvitationInviter")
  acceptedInvitations Invitation[]        @relation("InvitationAcceptedUser")
  apiTokens           ApiToken[]          @relation("ApiTokenCreator")
}

model Board {
  id          String     @id
  userId      String
  name        String
  slug        String
  description String?
  iconKey     String
  accentColor String?
  sortOrder   Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  note        BoardNote?

  @@unique([userId, slug])
}

model Task {
  id          String        @id
  boardId      String
  title       String
  description String?
  status      TaskStatus
  priority    ItemPriority  @default(NONE)
  recurrence  RecurrencePattern @default(NONE)
  sortOrder   Int
  dashboardSortOrder Int?
  dueDate     DateTime?
  archivedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  board       Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  subtasks    Subtask[]
  labels      TaskLabel[]
  checklist   ChecklistItem[]

  @@index([boardId, status, sortOrder])
}

model Subtask {
  id         String       @id
  taskId     String
  title      String
  isComplete Boolean      @default(false)
  sortOrder  Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model TaskLabel {
  id        String   @id
  taskId    String
  text      String
  color     String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model ChecklistItem {
  id         String   @id
  taskId     String
  text       String
  isComplete Boolean  @default(false)
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model BoardNote {
  id        String   @id
  boardId   String   @unique
  content   String
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id               String    @id
  email            String
  tokenHash        String    @unique
  invitedById      String
  acceptedByUserId String?   @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  invitedBy        User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy       User?     @relation("InvitationAcceptedUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([invitedById])
}

model ApiToken {
  id          String    @id
  label       String
  tokenHash   String    @unique
  prefix      String
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   User      @relation("ApiTokenCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([revokedAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model AdminAuditLog {
  id        String   @id
  actor     String
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
